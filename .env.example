# ==============================================================================
# KnightED — Environment Configuration Template
# Academic Peer-Tutoring & Cambridge Resource Management Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# Connection URI for MongoDB Atlas cluster or local MongoDB instance.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/knighted?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/knighted

# ------------------------------------------------------------------------------
# 2. Authentication & Edge Cryptography
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure secret used by jose (HS256) for signing edge JWT session tokens.
# Generate via: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ------------------------------------------------------------------------------
# 3. Media & Document CDN (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary credentials for hosting course lesson videos, PDF handouts, and past papers.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------------------------
# Base URL of the deployment (used for absolute callbacks and verification URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
